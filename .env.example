# OpenRouter API key
OPENROUTER_API_KEY=

# Local web origins allowed by the backend.
# WEB_ORIGIN is still supported for a single origin.
WEB_ORIGINS=http://127.0.0.1:5173,http://localhost:5173

OPENROUTER_MAX_CONCURRENT_REQUESTS=3
OPENROUTER_MAX_REQUESTS_PER_MINUTE=18

OPENROUTER_MAX_ATTEMPTS=4
LLM_COMPACT_RETRY_MAX_INPUT_TOKENS=15000
LLM_LARGE_RETRY_INPUT_TOKENS=50000

RULES_PER_FRAGMENT_REQUEST=4
CHECK_PACKET_MAX_ATTEMPTS=2
FACT_ENTITY_RECOVERY_ATTEMPTS=2

CANDIDATE_BATCH_SIZE=10
CANDIDATE_MISSING_RETRY_ROUNDS=2
CANDIDATE_RECOVERY_PAIR_BATCH_SIZE=8

ABBREVIATION_FACT_MAP_CHUNK_SIZE=10
ABBREVIATION_FACT_MAP_CONCURRENCY=2
ABBREVIATION_FACT_MAP_RECOVERY_CHUNK_SIZE=5
ABBREVIATION_FACT_MAP_RECOVERY_ROUNDS=2
