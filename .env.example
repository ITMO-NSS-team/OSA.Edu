# OpenRouter API key
OPENROUTER_API_KEY=

# LLM request limits. We intentionally prefer more small requests over a few
# large fragile JSON completions.
OPENROUTER_MAX_CONCURRENT_REQUESTS=3
OPENROUTER_MAX_REQUESTS_PER_MINUTE=18

# Provider attempt ceiling. Actual attempts are also bounded by prompt cost:
# <=15k estimated input tokens -> up to 4 attempts
# 15k..50k -> up to 3 attempts
# >50k -> up to 2 attempts
OPENROUTER_MAX_ATTEMPTS=4
LLM_COMPACT_RETRY_MAX_INPUT_TOKENS=15000
LLM_LARGE_RETRY_INPUT_TOKENS=50000

# Semantic rules: fewer rules per fragment means smaller output JSON and easier
# targeted recovery when one rule is omitted or malformed.
RULES_PER_FRAGMENT_REQUEST=4
CHECK_PACKET_MAX_ATTEMPTS=2
FACT_ENTITY_RECOVERY_ATTEMPTS=2

# Candidate-first LLM checks. Smaller primary batches reduce malformed JSON;
# missing exact candidate/rule pairs are retried separately.
CANDIDATE_BATCH_SIZE=10
CANDIDATE_MISSING_RETRY_ROUNDS=2
CANDIDATE_RECOVERY_PAIR_BATCH_SIZE=8

# Abbreviation Fact Map. The logical inventory is split aggressively. A failed
# packet no longer discards rows from other packets, and recovery works only on
# unresolved candidates.
ABBREVIATION_FACT_MAP_CHUNK_SIZE=10
ABBREVIATION_FACT_MAP_CONCURRENCY=2
ABBREVIATION_FACT_MAP_RECOVERY_CHUNK_SIZE=5
ABBREVIATION_FACT_MAP_RECOVERY_ROUNDS=2

# MCP Автонормоконтроль
NORMCONTROL_MCP_URL=http://mcp.10.32.11.60.nip.io/mcp
NORMCONTROL_DAG_ID=flow-dqc-control-10
NORMCONTROL_MCP_ATTEMPTS=3
NORMCONTROL_MCP_ATTEMPT_TIMEOUT_SECONDS=30
NORMCONTROL_HTTP_TIMEOUT_SECONDS=120

# Literature review. The same OpenRouter key is used.
LITERATURE_REVIEW_MODEL=z-ai/glm-5.3-flash
LITERATURE_WEB_SEARCH_ENABLED=true
WEB_ORIGINS=http://127.0.0.1:5173,http://localhost:5173

# Optional contact used by Crossref polite-pool requests.
CROSSREF_MAILTO=

# Literature web verification. Server tools are tried first; if the selected
# provider/tool gateway fails (including the previous "Missing Authentication
# header" case), the checker automatically falls back to OpenRouter's model-
# agnostic web plugin.
LITERATURE_WEB_FALLBACK_TO_PLUGIN=true
LITERATURE_WEB_SEARCH_ENGINE=exa
# Leave empty unless you intentionally want to pin OpenRouter provider names.
LITERATURE_WEB_PROVIDER_ORDER=
# Reproducibility / OSA integration. OSA.Edu is a thin web shell: the
# analysis itself is delegated to OSA's canonical --paper-analysis pipeline
# from feat/thesis-repository-analysis (PaperClaimPipeline + ClaimVerifier).
# OSA.Edu does not implement claim extraction/filtering/batching/verification rules.
REPRODUCIBILITY_MODEL=openai/gpt-5.6-luna
REPRODUCIBILITY_TIMEOUT_SECONDS=3600
REPRODUCIBILITY_HEARTBEAT_SECONDS=20
REPRODUCIBILITY_REPOSITORY_HOSTS=github.com,gitlab.com,gitverse.ru,sourcecraft.dev,git.sourcecraft.dev
# Optional SourceCraft PAT. Public repositories do not require it.
# Private SourceCraft repositories use SOURCECRAFT_TOKEN; OSA also falls back to GIT_TOKEN.
SOURCECRAFT_TOKEN=
REPRODUCIBILITY_CONTEXT_WINDOW=65536
REPRODUCIBILITY_MAX_TOKENS=8000
REPRODUCIBILITY_LLM_MAX_RETRIES=3
# Optional external OSA runner override. The command must write paper_analysis.json.
# Available placeholders: {repository} {paper} {output} {model} {base_url}
# REPRODUCIBILITY_OSA_COMMAND=
