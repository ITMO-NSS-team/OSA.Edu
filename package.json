{
  "name": "OSA.Edu",
  "version": "4.0.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=20.19.0" },
  "scripts": {
    "dev": "concurrently -k -n server,web -c blue,green \"npm run dev:server\" \"npm run dev:web\"",
    "dev:server": "python -m uvicorn backend.app.main:app --reload --host 127.0.0.1 --port 8787",
    "dev:web": "vite --host 127.0.0.1"
  },
  "dependencies": {
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "devDependencies": {
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "concurrently": "^9.2.1",
    "typescript": "^5.9.2",
    "vite": "^6.1.0"
  }
}
